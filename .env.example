# คัดลอกเป็น .env แล้วเติมค่าจริง — .env ถูก gitignore ไว้แล้ว

# ── ฐานข้อมูล ──
# แอปเชื่อมด้วย role `app` ที่เป็น NOBYPASSRLS และไม่ใช่เจ้าของตาราง (กฎข้อ 1)
# ห้ามใช้ postgres superuser ในตัวแปรนี้เด็ดขาด เพราะข้าม RLS ได้ทุกกรณี
DATABASE_URL=postgres://app:devonly@localhost:5432/taronex

# migration ต้องใช้เจ้าของตาราง จึงเป็นคนละ URL โดยตั้งใจ
DATABASE_MIGRATION_URL=postgres://postgres:devonly@localhost:5432/taronex

# ── ที่เก็บไฟล์ (S3 API) ──
# ตอนพัฒนาชี้ไป MinIO · เครื่องจริงชี้ไป DigitalOcean Spaces
S3_ENDPOINT=http://localhost:9000
S3_REGION=sgp1
S3_BUCKET=taronex-dev
S3_ACCESS_KEY=taronex
S3_SECRET_KEY=devonly123
S3_FORCE_PATH_STYLE=true

# ── อีเมล ──
# ตอนพัฒนาชี้ไป Mailpit · เครื่องจริงใช้ Resend
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
MAIL_FROM=TaroNex <noreply@taronex.co>

# ── เซสชัน ──
# ⚠ บังคับเมื่อ NODE_ENV=production — ไม่ตั้งแล้วแอปจะโยนข้อผิดพลาดทันที
#   (เคยปล่อยว่างบนเครื่องจริงหลายวัน แล้วเซ็นด้วยค่า dev ที่อยู่ในโค้ดซึ่งเปิดสาธารณะ)
# สร้างด้วย: openssl rand -base64 48
SESSION_SECRET=
#
# คุกกี้ฝั่งทีมกับพอร์ทัลลูกค้าต้องแยกกันโดยเด็ดขาด (กฎข้อ 6)
# ทำด้วยการเติม `portal:` นำหน้าตอนเซ็น ไม่ใช่ตัวแปรที่สอง —
# ตัวแปรที่สองแปลว่ามีค่าที่ลืมตั้งได้อีกหนึ่งค่า ซึ่งเพิ่งเป็นบทเรียนมาแล้ว
# คุกกี้ฝั่งทีมไม่ได้เซ็น มันเป็นโทเคนสุ่มที่เก็บ hash ไว้ในตาราง sessions

# ── อื่นๆ ──
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
