{
  "name": "taronex-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:rls": "tsx src/db/apply-rls.ts",
    "db:reset": "pnpm db:migrate && pnpm db:rls && pnpm db:seed"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.4",
    "postgres": "^3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "^0.31.10",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.12",
    "typescript": "5.9.2",
    "vitest": "^4.1.11"
  }
}
